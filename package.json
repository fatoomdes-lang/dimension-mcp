  "description": "MCP server that lets Claude Code, Codex and other AI agents drive Adobe Dimension: models, materials, decals, cameras, Match Image and rendering.",
  "type": "module",
  "bin": {
    "dimension-mcp": "src/index.js"
  },
  "main": "src/index.js",
