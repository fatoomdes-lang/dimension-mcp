    "codex",
    "ai-agent"
  ],
  "author": "Fatimah Almehmadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatoomdes-lang/dimension-mcp.git"
  },
  "homepage": "https://github.com/fatoomdes-lang/dimension-mcp#readme",
